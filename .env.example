# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais committer .env.
# Encadrer par des apostrophes les valeurs contenant des espaces, # ou $.

# Les équipements à surveiller se gèrent dans l'interface web

# Application web
# Mot de passe de l'administrateur (obligatoire pour argus serve)
ARGUS_ADMIN_PASSWORD=
ARGUS_HOST=127.0.0.1
ARGUS_PORT=8000
ARGUS_DB_PATH=data/argus.db

# Identifiants SSH (utilisateur et mot de passe obligatoires)
ARGUS_USERNAME=
ARGUS_PASSWORD=
# Mot de passe du mode enable
ARGUS_SECRET=

# Délais en secondes
ARGUS_TIMEOUT=20
ARGUS_SESSION_TIMEOUT=20
ARGUS_MONITOR_INTERVAL=60

# Nombre d'équipements interrogés en parallèle
ARGUS_MAX_WORKERS=10

# DEBUG, INFO, WARNING ou ERROR
ARGUS_LOG_LEVEL=INFO

# Algorithmes SSH obsolètes : true uniquement dans un lab isolé
ARGUS_ALLOW_LEGACY_SSH=false
